# MiSitio IA — variables de entorno (plantilla)
# Copia a .env.local y llena los valores. NO subir .env.local a git.

# --- Supabase MiSitio IA (mthlqoploeisigzvwory) ---
NEXT_PUBLIC_SUPABASE_URL=https://mthlqoploeisigzvwory.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=            # anon/publishable key (render público de sitios)
SUPABASE_SERVICE_ROLE_KEY=               # service_role — REQUERIDA por el generador (escribe sitios). Secreto.

# --- Supabase TerraLeads (solo lectura de leads) ---
TERRALEADS_SUPABASE_URL=https://xnffgxnzwqqkghdwhxyj.supabase.co
TERRALEADS_SUPABASE_SERVICE_KEY=         # service_role de TerraLeads — REQUERIDA por el generador (lee leads). Secreto.

# --- Gemini (redacción de textos) ---
GEMINI_API_KEY=                          # modelo gemini-2.5-flash

# --- Generador ---
GENERATOR_SECRET=                        # Bearer token para POST /api/generate

# --- Dominio ---
NEXT_PUBLIC_ROOT_DOMAIN=misitioia.com
