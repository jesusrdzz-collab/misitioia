# MiSitio IA — variables de entorno (plantilla)
# Copia a .env.local y llena los valores. NO subir .env.local a git.

# --- Supabase MiSitio IA (mthlqoploeisigzvwory) ---
NEXT_PUBLIC_SUPABASE_URL=https://mthlqoploeisigzvwory.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=            # anon/publishable key (render público de sitios)
SUPABASE_SERVICE_ROLE_KEY=               # service_role — REQUERIDA por el generador (escribe sitios). Secreto.

# --- Supabase TerraLeads (solo lectura de leads) ---
TERRALEADS_SUPABASE_URL=https://xnffgxnzwqqkghdwhxyj.supabase.co
TERRALEADS_SUPABASE_SERVICE_KEY=         # service_role de TerraLeads — REQUERIDA por el generador (lee leads). Secreto.

# --- Gemini (redacción de textos + editor por chat) ---
GEMINI_API_KEY=                          # modelo gemini-2.5-flash (generador Fase 2 + agente editor Fase 4)

# --- Generador ---
GENERATOR_SECRET=                        # Bearer token para POST /api/generate

# --- Dominio ---
NEXT_PUBLIC_ROOT_DOMAIN=misitio.site     # subdominios negocio.misitio.site, panel app.misitio.site

# --- Conexión de dominios personalizados (API de Vercel) ---
# Sin estas variables, el panel de dominio degrada a instrucciones manuales
# (nunca crashea). Con ellas, el dominio del cliente se adjunta automáticamente
# al proyecto y el panel muestra el estado real de verificación.
VERCEL_API_TOKEN=                        # token de Vercel con permiso sobre el proyecto. Secreto.
VERCEL_PROJECT_ID=prj_0wwfEMEhrxKOcKQKJa3MsPVyDoCj   # proyecto misitioia
VERCEL_TEAM_ID=team_YqaLMAliicxls7krhLmY1cCx        # equipo dueño del proyecto

# --- Victoria "de regreso" (Konnex webchat) ---
# Base del backend de Konnex (una sola fuente de verdad). Default en código:
# https://app.konnex.center — reutilizada por el modo sitio y el modo self.
KONNEX_WEBCHAT_BASE=https://app.konnex.center
# Token webchat de la PROPIA MiSitio (tenant dedicado ffd460a0, cargado con la
# KB de MiSitio). Con él, Victoria atiende y vende MiSitio en la homepage
# (modo self). Sin él, el widget de la home no se renderiza (inerte/invisible).
# Secreto de servidor: NUNCA se expone al navegador.
KONNEX_SELF_WEBCHAT_TOKEN=

# --- Stripe (facturación de suscripciones — modo TEST) ---
STRIPE_SECRET_KEY=                       # sk_test_... — secreto de servidor, NUNCA en el cliente
STRIPE_WEBHOOK_SECRET=                   # whsec_... — firma del endpoint /api/stripe/webhook
STRIPE_PRICE_EMPRENDE=                   # price_... del plan Emprende ($10/mes, 100 conversaciones)
STRIPE_PRICE_CRECE=                      # price_... del plan Crece ($25/mes, 400 conversaciones)
STRIPE_PRICE_PRO=                        # price_... del plan Pro ($50/mes, 1000 conversaciones)
